# ==============================================================================
# TubePilot - AI YouTube Growth Desktop App Environment Configuration
# ==============================================================================
# Note: You can paste your API keys directly into the app Settings page!
# Keys are securely encrypted using your operating system's native keychain
# (DPAPI on Windows, Apple Keychain on macOS, Secret Service on Linux).
#
# Alternatively, you can seed default environment variables here:

# --- AI TEXT PROVIDERS (Choose Claude, OpenAI, or Gemini) ---
# Default recommended: Anthropic Claude 3.5 Sonnet
ANTHROPIC_API_KEY=sk-ant-api03-...

# OpenAI GPT-4o
OPENAI_API_KEY=sk-proj-...

# Google Gemini 2.5 Flash
GEMINI_API_KEY=AIzaSy...

# --- IMAGE PROVIDERS ---
# Stability AI (SD 3.5 / Core)
STABILITY_API_KEY=sk-...

# Replicate API (Flux 1.1 Pro)
REPLICATE_API_TOKEN=r8_...

# --- VIDEO PROVIDERS (Optional - local FFmpeg fallback runs with 0 keys!) ---
RUNWAY_API_KEY=key_...
LUMA_API_KEY=luma-...

# --- YOUTUBE OAUTH 2.0 PKCE CREDENTIALS ---
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# Application Type: Desktop App
YOUTUBE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxx.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx

# --- LOCAL PREFERENCES ---
TUBEPILOT_THEME=dark
TUBEPILOT_DAILY_SHORTS=2
TUBEPILOT_DAILY_LONG=1
